# .env.local.example
# 이 파일을 .env.local 로 복사해서 값을 채우세요.
# .env.local 은 커밋하지 않습니다.

# Supabase — 대시보드 Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# xAI — https://console.x.ai
# NEXT_PUBLIC_ 을 절대 붙이지 마세요. 브라우저 번들에 들어갑니다.
XAI_API_KEY=xai-...

# 프롬프트를 영문으로 다듬는 텍스트 모델.
# 모델 이름은 자주 바뀌므로 xAI 콘솔의 모델 목록과 대조하세요.
XAI_TEXT_MODEL=grok-4.20-0309-non-reasoning

# 학생 비밀번호 초기화에만 씁니다 — 대시보드 Project Settings → API
#
# 이 키는 RLS 를 통째로 무시합니다. 이 키를 쥔 사람은 모든 학생의 자료를
# 읽고 지울 수 있습니다. NEXT_PUBLIC_ 을 붙이지 마세요. 없어도 나머지
# 기능은 전부 동작하고, 비밀번호 초기화만 닫힙니다.
SUPABASE_SERVICE_ROLE_KEY=

# 백업을 받을 곳. 없으면 프로젝트의 backup/ 에 쌓입니다.
# 구글 드라이브 데스크톱을 쓰면 내 드라이브 안 폴더를 적으세요 —
# 받는 즉시 클라우드로 올라갑니다. (OFFLINE.md)
# BACKUP_DIR=G:\내 드라이브\전시보관
